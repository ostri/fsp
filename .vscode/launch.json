{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "fsp-core",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceRoot}/build/fsp",
      "args": [
        "../xml-data/pacs8-2.xml",
        "../xsd/pacs.008.xsd",
      ],
      "cwd": "${workspaceRoot}/build",
      "preLaunchTask": "build", // Najprej požene task "build" v tasks.json
    },
    {
      "name": "small file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceRoot}/build/fsp",
      "args": [
        "../xml-data/pacs8-2.xml",
      ],
      "cwd": "${workspaceRoot}/build",
      "preLaunchTask": "build", // Najprej požene task "build" v tasks.json
      "environment": [
        {
          "name": "ASAN_OPTIONS",
          "value": "detect_leaks=0"
        }
      ]
    },
    {
      "name": "pacs8",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceRoot}/build/pacs8",
      "args": [
        "../xml-data/pacs8-2.xml",
      ],
      "cwd": "${workspaceRoot}/build",
      "preLaunchTask": "build", // Najprej požene task "build" v tasks.json
      "environment": [
        {
          "name": "ASAN_OPTIONS",
          "value": "detect_leaks=0"
        }
      ]
    }
  ]
}