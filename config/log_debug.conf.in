# fsp logger configuration template -- Debug build
# Generated by CMake's configure_file() into the build directory as
# log_<program>_debug.conf, with @PROGRAM_NAME@ substituted for the actual target name
# (see add_log_config() in CMakeLists.txt and fsp::load_logger_config() in src/lib/logger.cpp).
#
# log_level accepts spdlog names: trace/debug/info/warning/error/critical/off
# (aliases warn/err/crit are also accepted)
enable_console=true
enable_file=true
log_file_path=@PROGRAM_NAME@.log
log_level=trace