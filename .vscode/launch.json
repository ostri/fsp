{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pacs8",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/pacs8",
      "args": [
        "../../xml-data/pacs8-2.xml"
      ],
      "cwd": "${workspaceFolder}/build/debug",
      "preLaunchTask": "build",
      "environment": [
        {
          "name": "ASAN_OPTIONS",
          "value": "detect_leaks=0"
        }
      ]
    },
    {
      "name": "pacs8-cb",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/pacs8-cb",
      "args": [
        "../../xml-data/pacs8-2.xml"
      ],
      "cwd": "${workspaceFolder}/build/debug",
      "preLaunchTask": "build",
      "environment": [
        {
          "name": "ASAN_OPTIONS",
          "value": "detect_leaks=0"
        }
      ]
    },
    {
      "name": "validator",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/validator",
      "args": [
        "../../xsd/pacs.008.xsd",
        "../../xml-data/pacs8-2.xml"
      ],
      "cwd": "${workspaceFolder}/build/debug",
      "preLaunchTask": "build",
      "environment": [
        {
          "name": "ASAN_OPTIONS",
          "value": "detect_leaks=0"
        }
      ]
    },
    {
      "name": "unit_tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/unit_tests",
      "args": [],
      "cwd": "${workspaceFolder}/build/debug",
      "preLaunchTask": "build"
    }
  ]
}
